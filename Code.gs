// ═══════════════════════════════════════════════════════════════
//  DEPLOY A FIREBASE HOSTING VIA REST API
// ═══════════════════════════════════════════════════════════════
function deployToFirebase(html) {
  const project = CONFIG.FIREBASE_PROJECT;

  // ── Usar el OAuth token de la cuenta de Google que ejecuta el script
  // Esto funciona automáticamente si el proyecto de Apps Script está vinculado
  // al mismo proyecto de Google Cloud que Firebase.
  // NO se necesita el firebase CI token para esto.
  const token = ScriptApp.getOAuthToken();

  Logger.log('  OAuth token obtenido: ' + token.substring(0, 20) + '...');

  // ── 1. Crear versión nueva ─────────────────────────────────────
  const versionUrl = 'https://firebasehosting.googleapis.com/v1beta1/sites/' + project + '/versions';
  const versionRes = UrlFetchApp.fetch(versionUrl, {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + token,
      'Content-Type': 'application/json'
    },
    payload: JSON.stringify({
      config: {
        headers: [{ glob: '**', headers: { 'Cache-Control': 'no-cache, max-age=0' } }]
      }
    }),
    muteHttpExceptions: true
  });

  const versionText = versionRes.getContentText();
  Logger.log('  Version API response: ' + versionText.substring(0, 200));

  if (versionRes.getResponseCode() !== 200) {
    throw new Error('Error creando versión Firebase: HTTP ' + versionRes.getResponseCode() + ' — ' + versionText.substring(0, 300));
  }

  const version     = JSON.parse(versionText);
  const versionName = version.name;
  Logger.log('  Version creada: ' + versionName);

  // ── 2. Gzip first, then SHA256 of gzipped content ──────────────
  // Firebase Hosting REST API v1beta1 requires:
  //   hash    = SHA256( gzip(raw) )
  //   payload = gzip(raw)
  //   NO Content-Encoding header on upload
  const htmlBytes = html;  // byte array from buildHTML() — no charset conversion needed
  const gzipBytes = Utilities.gzip(Utilities.newBlob(htmlBytes, 'text/html')).getBytes();
  const sha256    = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, gzipBytes);
  const hashHex   = sha256.map(function(b) {
    return ('0' + (b & 0xFF).toString(16)).slice(-2);
  }).join('');
  Logger.log('  raw size: ' + htmlBytes.length + ' | gzip size: ' + gzipBytes.length);
  Logger.log('  SHA256(gzip): ' + hashHex.substring(0, 20) + '...');

  // ── 3. Registrar archivos en la versión ───────────────────────
  const filesUrl = 'https://firebasehosting.googleapis.com/v1beta1/' + versionName + ':populateFiles';
  const filesRes = UrlFetchApp.fetch(filesUrl, {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + token,
      'Content-Type': 'application/json'
    },
    payload: JSON.stringify({ files: { '/index.html': hashHex } }),
    muteHttpExceptions: true
  });

  const filesText = filesRes.getContentText();
  Logger.log('  PopulateFiles response: ' + filesText.substring(0, 200));

  if (filesRes.getResponseCode() !== 200) {
    throw new Error('Error registrando archivos: HTTP ' + filesRes.getResponseCode() + ' — ' + filesText.substring(0, 300));
  }

  const filesData      = JSON.parse(filesText);
  const uploadUrl      = filesData.uploadUrl;
  const uploadRequired = filesData.uploadRequiredHashes || [];
  Logger.log('  uploadUrl: ' + (uploadUrl ? uploadUrl.substring(0, 60) + '...' : 'none'));
  Logger.log('  Upload requerido para ' + uploadRequired.length + ' archivo(s)');
  Logger.log('  hashHex: ' + hashHex.substring(0, 20) + '...');

  // ── 4. Subir HTML si el server lo requiere ────────────────────
  if (uploadRequired.indexOf(hashHex) !== -1 && uploadUrl) {
    // Use the gzipped bytes already computed for the hash

    const uploadRes = UrlFetchApp.fetch(uploadUrl + '/' + hashHex, {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + token,
        'Content-Type': 'application/octet-stream'
        // No Content-Encoding header — Firebase storage handles decompression internally
      },
      payload: gzipBytes,
      muteHttpExceptions: true
    });

    const uploadCode = uploadRes.getResponseCode();
    const uploadBody = uploadRes.getContentText().substring(0, 300);
    Logger.log('  Upload status: ' + uploadCode + ' | body: ' + uploadBody);

    if (uploadCode !== 200) {
      throw new Error('Error subiendo HTML: HTTP ' + uploadCode + ' — ' + uploadBody);
    }
    Logger.log('  HTML subido correctamente (gzip).');
  } else {
    Logger.log('  Archivo ya en cache, no se requiere upload.');
  }

  // ── 5. Finalizar versión ──────────────────────────────────────
  const finalizeUrl = 'https://firebasehosting.googleapis.com/v1beta1/' + versionName + '?update_mask=status';
  const finalizeRes = UrlFetchApp.fetch(finalizeUrl, {
    method: 'PATCH',
    headers: {
      'Authorization': 'Bearer ' + token,
      'Content-Type': 'application/json'
    },
    payload: JSON.stringify({ status: 'FINALIZED' }),
    muteHttpExceptions: true
  });

  Logger.log('  Finalize status: ' + finalizeRes.getResponseCode());
  if (finalizeRes.getResponseCode() !== 200) {
    throw new Error('Error finalizando versión: HTTP ' + finalizeRes.getResponseCode() + ' — ' + finalizeRes.getContentText().substring(0, 200));
  }
  Logger.log('  Versión finalizada.');

  // ── 6. Crear release (activar en producción) ──────────────────
  const releaseUrl = 'https://firebasehosting.googleapis.com/v1beta1/sites/' + project + '/releases?versionName=' + encodeURIComponent(versionName);
  const releaseRes = UrlFetchApp.fetch(releaseUrl, {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer ' + token,
      'Content-Type': 'application/json'
    },
    payload: '{}',
    muteHttpExceptions: true
  });

  Logger.log('  Release status: ' + releaseRes.getResponseCode());
  if (releaseRes.getResponseCode() !== 200) {
    throw new Error('Error creando release: HTTP ' + releaseRes.getResponseCode() + ' — ' + releaseRes.getContentText().substring(0, 200));
  }
  Logger.log('  ✅ Release activado. Sitio en vivo: https://' + project + '.web.app');
}


