// ═══════════════════════════════════════════════════════════════
//  FUNCIÓN PRINCIPAL — Llamada por el trigger lunes 6am
// ═══════════════════════════════════════════════════════════════
function buildAndDeploy() {
  try {
    Logger.log('▶ Iniciando build...');

    // Forzar reconocimiento de scopes necesarios
    const _testSheet = SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);
    const _testToken = ScriptApp.getOAuthToken();

    const ss       = _testSheet;
    const allData  = parseScorecard(ss);
    const dnrData  = parseDNR(ss);
    const weeks    = getAvailableWeeks(allData);
    const weekOpts = buildWeekOptions(weeks);

    Logger.log(`  Semanas encontradas: ${weeks.join(', ')}`);
    Logger.log(`  Conductores totales: ${allData.length}`);
    Logger.log(`  DNRs W16: ${(dnrData['W16']||[]).length}, W17: ${(dnrData['W17']||[]).length}`);

    const html = buildHTML(allData, dnrData, weeks, weekOpts);

    // Guardar HTML en Drive para referencia
    saveHTMLToDrive(html);

    // Deploy a Firebase Hosting via REST API
    deployToFirebase(html);

    Logger.log('✅ Deploy completado exitosamente.');
    sendSuccessEmail(weeks);

  } catch (err) {
    Logger.log('❌ Error: ' + err.message);
    sendErrorEmail(err);
  }
}

// ═══════════════════════════════════════════════════════════════
//  PARSEO DE SCORECARD
// ═══════════════════════════════════════════════════════════════
function parseScorecard(ss) {
  const sheet  = ss.getSheetByName(SHEET_SCORECARD);
  const values = sheet.getDataRange().getValues();
  const result = [];

  for (let i = 0; i < values.length; i++) {
    const row = values[i];
    // Fila de datos: col[0] empieza con "202" (año)
    if (!String(row[0]).startsWith('202')) continue;

    const semana  = String(row[0]).trim();
    const name    = String(row[1]).trim();
    const pkgs    = Number(row[3])  || 0;
    const dnr     = Number(row[4])  || 0;
    const sent    = Number(row[6])  || 0;
    const rts     = Number(row[7])  || 0;
    const rtsPct  = parseFloat(row[8]) || 0;
    const faltas  = Number(row[10]) || 0;
    const safety  = Number(row[11]) || 100;
    const score   = parseFloat(row[18]) || 0;
    const nota    = String(row[19] || '').trim();
    const alertRaw= String(row[20] || '').trim();

    let alert = 'VERDE';
    if (alertRaw.includes('ROJO'))     alert = 'ROJO';
    else if (alertRaw.includes('AMARILLO')) alert = 'AMARILLO';

    // Regla de negocio: 1+ faltas = No premio (independiente de alerta)
    const premio = (alert === 'VERDE' || alert === 'AMARILLO') && faltas === 0;
    const delPct = sent > 0 ? (pkgs / sent) * 100 : 100;

    result.push({
      s: semana, name, pkgs, sent, dnr,
      rts, rtsPct: rtsPct < 1 ? parseFloat((rtsPct * 100).toFixed(2)) : parseFloat(rtsPct.toFixed(2)),
      faltas, safety, score: parseFloat(score.toFixed(2)),
      nota, alert, premio,
      delPct: parseFloat(delPct.toFixed(2)),
      idx: result.length + 1
    });
  }

  return result;
}

// ═══════════════════════════════════════════════════════════════
//  PARSEO DNR
// ═══════════════════════════════════════════════════════════════
function parseDNR(ss) {
  const sheet  = ss.getSheetByName(SHEET_DNR);
  const values = sheet.getDataRange().getValues();
  const result = {};

  let currentWeek = null;

  for (let i = 0; i < values.length; i++) {
    const cell0 = String(values[i][0]).trim();

    // Detectar encabezado de semana (e.g. "W16 DNR VZLY...", "W17/DNR´S/VZLY...")
    const weekMatch = cell0.match(/W(\d{2})/i);
    if (weekMatch && cell0.length > 3 && !cell0.startsWith('TBM')) {
      const wNum = weekMatch[1];
      // Mapear número de semana al key de datos (ej W16 → 2026-16)
      currentWeek = `W${wNum}`;
      if (!result[currentWeek]) result[currentWeek] = [];
      continue;
    }

    // Fila de datos DNR
    if (currentWeek && cell0.startsWith('TBM')) {
      const row      = values[i];
      const driver   = String(row[3] || '').trim();
      const ruta     = String(row[4] || '').trim();
      const distRaw  = String(row[5] || '');
      const distNum  = parseFloat(distRaw.replace(/[^\d.]/g, '')) || null;
      const montoRaw = String(row[6] || '0').replace(/[$,\s]/g, '');
      const monto    = parseFloat(montoRaw) || 0;
      const tipo     = String(row[8] || '').trim();
      const pasaRaw  = String(row[11] || '').trim().toUpperCase();
      const pasa     = pasaRaw.includes('SI') ? 'SI' : pasaRaw.includes('NO') ? 'NO' : '?';
      const motivo   = String(row[12] || '').trim();

      if (driver && driver !== 'NOMBRE DEL DRIVER') {
        result[currentWeek].push({
          tracking: cell0, driver, ruta,
          distancia: distNum,
          monto: parseFloat(monto.toFixed(2)),
          tipo, pasa, motivo
        });
      }
    }
  }

  return result;
}

// ═══════════════════════════════════════════════════════════════
//  HELPERS
// ═══════════════════════════════════════════════════════════════
function getAvailableWeeks(data) {
  return [...new Set(data.map(d => d.s))].sort();
}

function buildWeekOptions(weeks) {
  return weeks.map(w => {
    const label = WEEK_LABELS[w] || w;
    return `<option value="${w}">${label}</option>`;
  }).join('\n            ');
}

