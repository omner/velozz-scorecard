function sendSuccessEmail(weeks) {
  MailApp.sendEmail({
    to: CONFIG.NOTIFY_EMAIL,
    subject: '✅ VELOZZ Scorecard — Deploy exitoso',
    body: `El scorecard fue actualizado automáticamente.\n\nSemanas publicadas: ${weeks.join(', ')}\nFecha: ${new Date().toLocaleString('es-MX')}\n\nURL: https://${CONFIG.FIREBASE_PROJECT}.web.app`
  });
}

function sendErrorEmail(err) {
  MailApp.sendEmail({
    to: CONFIG.NOTIFY_EMAIL,
    subject: '❌ VELOZZ Scorecard — Error en deploy',
    body: `Ocurrió un error al actualizar el scorecard.\n\nError: ${err.message}\n\nStack: ${err.stack || 'N/A'}\nFecha: ${new Date().toLocaleString('es-MX')}`
  });
}

// ═══════════════════════════════════════════════════════════════
//  CONFIGURAR TRIGGER AUTOMÁTICO (ejecutar UNA SOLA VEZ)
// ═══════════════════════════════════════════════════════════════
function setupWeeklyTrigger() {
  // Eliminar triggers existentes
  ScriptApp.getProjectTriggers().forEach(t => ScriptApp.deleteTrigger(t));

  // Crear trigger: lunes a las 6am (hora de la cuenta Google)
  ScriptApp.newTrigger('buildAndDeploy')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.MONDAY)
    .atHour(6)
    .create();

  Logger.log('✅ Trigger configurado: lunes 6:00am');
}

// ═══════════════════════════════════════════════════════════════
//  EJECUTAR ESTA FUNCIÓN UNA VEZ PARA REAUTORIZAR SCOPES
//  Ir a: Ejecutar → resetOAuth → aceptar todos los permisos
// ═══════════════════════════════════════════════════════════════
function resetOAuth() {
  // Llamar explícitamente a cada servicio para forzar el reconocimiento de scopes
  try { SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID); } catch(e) { Logger.log('Sheets: ' + e.message); }
  // Drive test omitido — scope drive no requerido (logo incrustado en script)
  try { ScriptApp.getOAuthToken(); } catch(e) { Logger.log('Token: ' + e.message); }
  try { MailApp.getRemainingDailyQuota(); } catch(e) { Logger.log('Mail: ' + e.message); }
  try { UrlFetchApp.fetch('https://www.googleapis.com', {muteHttpExceptions:true}); } catch(e) { Logger.log('UrlFetch: ' + e.message); }
  try { Session.getEffectiveUser().getEmail(); } catch(e) { Logger.log('Session: ' + e.message); }
  Logger.log('✅ OAuth reset completado. Ahora ejecuta buildAndDeploy().');
}


// ═══════════════════════════════════════════════════════════════
//  GENERADOR DE HTML
//  Inyecta los datos del Sheets en el template de la página
// ═══════════════════════════════════════════════════════════════
// ═══════════════════════════════════════════════════════════════
//  HTML TEMPLATE (base64-encoded prefix and suffix)
//  The working scorecard HTML is split at the data block.
//  GAS injects fresh JSON data from Sheets at runtime.
// ═══════════════════════════════════════════════════════════════
const HTML_PREFIX_B64 = [
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  '',
  '',
].join('');

const HTML_SUFFIX_B64 = [
  '',
  '',
  '',
].join('');


// ═══════════════════════════════════════════════════════════════
//  GENERADOR DE HTML — inyecta datos frescos en el template
// ═══════════════════════════════════════════════════════════════
function buildHTML(allData, dnrData, weeks, weekOpts) {
  // Work at byte level to avoid any charset conversion issues.
  // getDataAsString() can silently mangle multi-byte UTF-8 chars.
  const prefixBytes = Utilities.base64Decode(HTML_PREFIX_B64);
  const suffixBytes = Utilities.base64Decode(HTML_SUFFIX_B64);

  // Build the JSON data block and convert to UTF-8 bytes
  const allJSON   = JSON.stringify(allData);
  const dnrJSON   = JSON.stringify(dnrData);
  const generated = new Date().toLocaleString('es-MX', {timeZone:'America/Mexico_City'});
  const dataBlock = 'const ALL = ' + allJSON + ';\nconst DNR = ' + dnrJSON + ';\nconst __GENERATED__ = "' + generated + '";\n';
  const dataBytes = Utilities.newBlob(dataBlock).getBytes();

  // Concatenate byte arrays: prefix + data + suffix
  const combined = [].concat(
    Array.from(prefixBytes),
    Array.from(dataBytes),
    Array.from(suffixBytes)
  );

  Logger.log('  HTML bytes: prefix=' + prefixBytes.length +
             ' data=' + dataBytes.length +
             ' suffix=' + suffixBytes.length +
             ' total=' + combined.length);

  return combined;  // returns byte array, not string
}

